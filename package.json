{
  "name": "candongueiro-api",
  "version": "0.1.0",
  "description": "CandongueiroPay API — monólito modular (DDD + Clean Architecture)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "postinstall": "prisma generate",
